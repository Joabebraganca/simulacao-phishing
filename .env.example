# =============================================================================
# Variaveis de ambiente — copie para .env.local e preencha.
# .env.local NUNCA vai para o git (ver .gitignore).
# =============================================================================

# --- Supabase (publicas — podem ir para o client) ---------------------------
# Encontradas em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Supabase (SECRETA — SOMENTE no servidor) --------------------------------
# ATENCAO: a service role key ignora o RLS. NUNCA use prefixo NEXT_PUBLIC_,
# nunca importe em componente client, nunca commite.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# --- URL base da aplicacao (para montar links/pixels com o token) ------------
# Em producao, a URL da Vercel. Em dev, http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
