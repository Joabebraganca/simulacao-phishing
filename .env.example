# =============================================================================
# Variaveis de ambiente — copie para .env.local e preencha.
# .env.local NUNCA vai para o git (ver .gitignore).
# =============================================================================

# --- Supabase (publicas — podem ir para o client) ---------------------------
# Encontradas em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Supabase (SECRETA — SOMENTE no servidor) --------------------------------
# ATENCAO: a service role key ignora o RLS. NUNCA use prefixo NEXT_PUBLIC_,
# nunca importe em componente client, nunca commite.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# --- URL base da aplicacao (para montar links/pixels com o token) ------------
# Em producao, a URL da Vercel. Em dev, http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Envio de e-mail (Fase 4) ------------------------------------------------
# Escolha o transporte: "smtp" (padrao) ou "n8n".
EMAIL_TRANSPORTE=smtp

# Se EMAIL_TRANSPORTE=smtp — credenciais do SMTP proprio.
# secure=true para porta 465 (TLS direto); false para 587 (STARTTLS).
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp

# Se EMAIL_TRANSPORTE=n8n — o webhook do n8n cuida do disparo.
# O painel faz POST com { de, para, assunto, html, texto }.
N8N_WEBHOOK_URL=https://seu-n8n/webhook/disparo
# Opcional: enviado no header x-webhook-secret para o n8n validar a origem.
N8N_WEBHOOK_SECRET=
